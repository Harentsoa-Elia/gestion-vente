# ============================================================================
# Configuration du site (Next.js) en PRODUCTION
# À copier sur le serveur en : /opt/guichetweb/front-office/.env.production
# Lue au moment de "npm run build" : après une modification, il faut reconstruire le site.
# ============================================================================

# Adresse INTERNE de l'API : le site relaie /api/v1 et /media vers elle (voir next.config.ts).
# Le port doit être celui de guichetweb-api.service.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8888/api/v1
