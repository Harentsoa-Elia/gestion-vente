# ============================================================================
# Fichier de configuration de l'API en PRODUCTION
# À copier sur le serveur en : /opt/guichetweb/backend/.env
# Ce fichier contient des secrets : il ne doit JAMAIS être envoyé sur GitHub.
# ============================================================================

# --- Base de données PostgreSQL (créée à l'étape 4 du guide) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guichetweb
DB_USER=guichetweb
DB_PASSWORD=METTRE_ICI_LE_MOT_DE_PASSE_DE_LA_BASE

# --- Sécurité ---
# Clé de signature des jetons de connexion (JWT). Générer avec :  openssl rand -hex 32
secret=METTRE_ICI_UNE_CLE_ALEATOIRE
algorithm=HS256
# Clé de chiffrement des QR codes des billets. Générer avec :
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATTENTION : ne plus jamais la changer une fois des billets vendus, sinon leurs QR codes deviennent illisibles.
QR_SECRET_KEY=METTRE_ICI_LA_CLE_FERNET

# --- Adresses publiques (liens dans les e-mails : billets, codes, PDF) ---
SITE_URL=https://VOTRE_DOMAINE
API_URL=https://VOTRE_DOMAINE

# --- Envoi des e-mails ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresse@gmail.com
# Mot de passe d'application Gmail (16 lettres), pas le mot de passe du compte Google
SMTP_PASSWORD=METTRE_ICI_LE_MOT_DE_PASSE_D_APPLICATION
SMTP_FROM_NAME=guichetweb
