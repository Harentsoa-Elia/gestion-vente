# Copie de référence : les vraies valeurs vont dans backend/.env (jamais versionné).

# --- Envoi des e-mails (codes de confirmation, mot de passe oublié) ---
# Sans SMTP_USER / SMTP_PASSWORD, les e-mails ne partent pas : ils s'affichent dans le terminal d'uvicorn.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
# Mot de passe d'application Gmail (16 lettres), PAS le mot de passe du compte Google
SMTP_PASSWORD=
SMTP_FROM_NAME=guichetweb
# Nom annoncé au serveur e-mail (facultatif, « localhost » par défaut)
# SMTP_LOCAL_HOSTNAME=localhost

# Adresse du site (liens dans les e-mails)
# SITE_URL=http://localhost:4000

# --- Sessions (facultatif) ---
# Durée du jeton d'accès, renouvelé automatiquement par le site (15 minutes par défaut)
# ACCESS_TOKEN_MINUTES=15
# Durée de la session sans se reconnecter (jeton de rafraîchissement, 7 jours par défaut)
# REFRESH_TOKEN_JOURS=7
